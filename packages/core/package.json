{
  "name": "@whiskeyjack-net/icon-stack-core",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./browser": {
      "import": "./src/adapters/browser.ts",
      "types": "./src/adapters/browser.ts"
    },
    "./node": {
      "import": "./src/adapters/node.ts",
      "types": "./src/adapters/node.ts"
    }
