      "optional": "true"
    }
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
