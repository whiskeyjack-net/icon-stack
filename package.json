{
  "name": "icon-stack",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:packages && vite",
    "build": "npm run build:packages && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run build:packages && vitest run && npm run test --workspaces --if-present",
    "typecheck": "npm run build:packages && tsc -b && npm run typecheck --workspaces --if-present",
    "build:packages": "npm run build --workspace @whiskeyjack-net/icon-stack-core",
    "check:release": "node scripts/check-release.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && node scripts/sync-web-version.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.1.1",
    "@whiskeyjack-net/design-system": "^0.14.0",
    "@whiskeyjack-net/i18n": "^0.1.1",
    "@whiskeyjack-net/icon-stack-core": "*",
    "@whiskeyjack-net/tauri": "^0.4.0",
    "fflate": "^0.8.2",
    "pica": "^9.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "description": "Generate a complete app-icon set for every platform from one source image.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiskeyjack-net/icon-stack.git"
  },
  "workspaces": [
    "packages/*"
  ]
}
